# 1. PSRAM Master Switches (need to add REQUIRES esp_psram)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
#CONFIG_SPIRAM_USE_MALLOC=y
#CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
#CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768


# 3. Flash Bus Settings (для задоволення Kconfig залежностей)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
#CONFIG_ESPTOOLPY_FLASHMODE_QIO=y 
#CONFIG_ESPTOOLPY_FLASH_VCC=3.3V # (Для обходу проблеми з напругою)

# --- Інші корисні налаштування для S3 ---
# Збільшуємо частоту CPU до 240MHz (для ML задач корисно)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240


# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="main/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="main/partitions.csv"

# HTTP Server (збільшуємо ліміт для ML API endpoints)
CONFIG_ESP_HTTPD_MAX_URI_HANDLERS=32
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Increase HTTP server stack size (default 4096 is not enough for our handlers)
# This is set in code via httpd_config_t.stack_size

# Stack protection (canary) - KEEP ENABLED
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y

# Heap corruption detection - KEEP ENABLED
CONFIG_HEAP_POISONING_COMPREHENSIVE=y

# FreeRTOS stack overflow detection - KEEP ENABLED
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# Main task stack size (default 3584 is too small for our init)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288