# Audio Dataset Preprocessor Configuration
# Copy this file to .env and modify as needed
# The .env file will be automatically loaded if python-dotenv is installed

# Path to raw (input) dataset directory (optional)
# If set, this path will be used as default input path for prepare_dataset.py
# Example: /path/to/raw/dataset or ./data/raw
# DATASET_INPUT_PATH=

# Output file path (default: dataset.pt)
# Full path to output dataset file. Used as default if --output is not specified.
# Used as is (not combined with input_path). Examples:
#   dataset.pt                   - relative path (saved relative to current directory)
#   /path/to/output/dataset.pt   - absolute path (saved at specified location)
#   ./outputs/dataset.pt         - relative path from current directory
# If not set and --output is not provided, an error will be raised.
DEFAULT_DATASET_FILE=dataset.pt

# Target sample rate in Hz (default: 16000)
# All audio files will be validated against this sample rate
DATASET_TARGET_SR=16000

# Triplet Memory Dataset Configuration
# Duration of audio chunks in seconds (default: 1.0)
# Used for triplet loss training
TRIPLET_DURATION_SEC=1.0

# Number of triplets to generate per epoch (default: 5000)
# Higher values provide more diverse samples but require more memory
TRIPLET_SAMPLES_PER_EPOCH=5000

# Ratio of abnormal samples to use as negatives (default: 0.5)
# Range: 0.0 to 1.0
# 0.0 = only use different machine IDs as negatives
# 0.5 = 50% abnormal samples from same machine, 50% different machine IDs
# 1.0 = only use abnormal samples from same machine as negatives
TRIPLET_ABNORMAL_RATIO=0.5

# Model Configuration
# Embedding dimension for TinyAudioCNN (default: 64)
# This determines the size of the output embedding vector
MODEL_EMBEDDING_DIM=64

# Model version to use for training (default: 1)
# Options: 1 (TinyAudioCNN - original), 2 (TinyAudioCNN_v2 - optimized for ESP32-S3)
# Note: For validation, model version is automatically detected from MLflow tags/params
# Supports formats: "1"/"2"/"3"/"4" or "v1"/"v2"/"v3"/"v4"
# v1=Standard, v2=DepthwiseSeparable, v3=MobileNetV2, v4=MBConv+SE-Attention
MODEL_VERSION=1

# Early Stopping Configuration
# Number of epochs without improvement before stopping (default: 10)
EARLY_STOPPING_PATIENCE=10

# Minimum change to qualify as an improvement (default: 0.0)
# Set to a small positive value (e.g., 0.001) to require meaningful improvement
EARLY_STOPPING_MIN_DELTA=0.0

# Minimum loss threshold to stop training (default: None)
# Training will stop if loss reaches or goes below this value
# Set to None to disable threshold-based stopping
EARLY_STOPPING_MIN_LOSS=

# Mode: 'min' for minimizing loss, 'max' for maximizing metric (default: min)
EARLY_STOPPING_MODE=min

# Print early stopping information (default: true)
EARLY_STOPPING_VERBOSE=true

# Restore best weights when stopping (default: true)
EARLY_STOPPING_RESTORE_BEST_WEIGHTS=true

# Enable early stopping (default: true)
EARLY_STOPPING_ENABLED=true

# Minimum number of epochs before early stopping can trigger (default: 30)
# Early stopping checks are disabled for the first min_epochs epochs
# This allows the model to train without premature stopping
EARLY_STOPPING_MIN_EPOCHS=30

# Training Configuration
# MLflow tracking URI (default: http://localhost:5000)
MLFLOW_TRACKING_URI=http://localhost:5000

# MLflow experiment name (default: MIMII_Triplet_Training)
MLFLOW_EXPERIMENT_NAME=MIMII_Triplet_Training

# MinIO/S3 Configuration for MLflow Artifacts
# S3 endpoint URL (for MinIO or custom S3-compatible storage)
# Example: http://localhost:9000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# AWS credentials (used for MinIO authentication)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Ignore TLS verification for S3 endpoint (default: false)
# Set to true if using self-signed certificates
MLFLOW_S3_IGNORE_TLS=false

# Batch size for training (default: 64)
TRAIN_BATCH_SIZE=64

# Number of training epochs (default: 30)
TRAIN_EPOCHS=30

# Loss function type (default: triplet_loss)
# Options: 'triplet_loss' or 'arcface'
# - triplet_loss: Standard TripletMarginLoss with Euclidean distance
# - arcface: ArcFace Loss with angular margin (normalizes embeddings to hypersphere)
TRAIN_LOSS_FUNCTION=triplet_loss

# Triplet loss margin (default: 1.0)
# For TripletMarginLoss: margin in Euclidean distance space
# For ArcFace: angular margin in radians (typically 0.3-0.5)
TRAIN_MARGIN=1.0

# Learning rate (default: 0.001)
# Initial learning rate (max_lr for CosineAnnealingWarmRestarts scheduler)
TRAIN_LEARNING_RATE=0.001

# Minimum learning rate for CosineAnnealingWarmRestarts scheduler (default: 0.00001)
# This is the eta_min parameter - the learning rate will decay smoothly from
# TRAIN_LEARNING_RATE to TRAIN_MIN_LEARNING_RATE using cosine annealing,
# then restart to TRAIN_LEARNING_RATE every T_0 epochs
TRAIN_MIN_LEARNING_RATE=0.00001

# Number of epochs for first restart cycle in CosineAnnealingWarmRestarts (default: 20)
# Every T_0 epochs, the learning rate restarts to TRAIN_LEARNING_RATE
# This helps escape local minima and improves convergence
TRAIN_SCHEDULER_T0=20

# Multiplier for restart period in CosineAnnealingWarmRestarts (default: 1)
# T_mult=1: constant restart period (every T_0 epochs)
# T_mult=2: doubling restart period (T_0, 2*T_0, 4*T_0, ...)
TRAIN_SCHEDULER_T_MULT=1

# Decay factor for restart LR in CosineAnnealingWarmRestartsWithDecay (default: 0.8)
# Each restart multiplies max_lr by this factor
# Example: if initial LR=0.001 and decay=0.8:
#   - First restart: LR restarts to 0.001 * 0.8 = 0.0008
#   - Second restart: LR restarts to 0.0008 * 0.8 = 0.00064
#   - And so on...
# This allows gradual reduction of exploration while maintaining fine-tuning capability
TRAIN_SCHEDULER_RESTART_DECAY=0.8

# Weight decay (L2 regularization) for AdamW optimizer (default: 0.0001)
# AdamW uses decoupled weight decay, which applies regularization directly to weights
# This is more effective than L2 regularization in standard Adam
# Typical values: 0.0001 (default), 0.0005 (stronger), 0.00001 (weaker)
TRAIN_WEIGHT_DECAY=0.0001

# Dimensionality reduction method for 3D visualization (default: pca)
# Options: 'pca' (faster, linear) or 'tsne' (slower, non-linear, better separation)
VISUALIZATION_REDUCTION_METHOD=pca

# Enable saving checkpoints every 5 epochs (default: false)
# Set to true to save model checkpoints during training
SAVE_CHECKPOINTS=false

# Model Testing/Validation Configuration
# RMS threshold for silence filtering during validation (default: 0.0001)
# Used to filter out silent audio chunks during model testing
TEST_RMS_THRESHOLD=0.0001

# Number of validation iterations per machine type (default: 50)
# Used in run_full_validation function
VALIDATION_ITERATIONS=50

# Number of mel spectrograms to use for calibration during validation (default: 50)
# Used in validate_model and run_full_validation functions
VALIDATION_CALIBRATION_SAMPLES=50

# Multiplier for standard deviation when calculating anomaly threshold (default: 3.0)
# Threshold = mean_distance + VALIDATION_THRESHOLD_STD_MULTIPLIER * std_distance
# Used in validate_model and run_full_validation functions
VALIDATION_THRESHOLD_STD_MULTIPLIER=3.0

